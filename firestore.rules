rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\s\\-]+$');
    }

    function isSystemOwner() {
      return isSignedIn() && request.auth.token.email == 'omarenriqueflores@gmail.com';
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return isSystemOwner() || (hasUserDoc() && getUserData().active != false) || isSignedIn();
    }

    function getUserRole() {
      return hasUserDoc() ? getUserData().role : (isSystemOwner() ? 'SUPERADMIN' : 'CAJERO');
    }

    function isAdmin() {
      return isSystemOwner() || (isUserActive() && (getUserRole() == 'SUPERADMIN' || getUserRole() == 'ADMIN'));
    }

    function isOperator() {
      return isSystemOwner() || (isUserActive() && (getUserRole() in ['SUPERADMIN', 'ADMIN', 'ENCARGADO', 'CAJERO']));
    }

    // 1. Users & Roles Management Collection
    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId);
      allow create: if isSignedIn() && isValidId(userId) && (
        isAdmin() || (
          request.auth.uid == userId && 
          !(request.resource.data.role in ['SUPERADMIN', 'ADMIN'])
        )
      );
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() || (
          request.auth.uid == userId && 
          request.resource.data.role == resource.data.role
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 2. Products Catalog Collection
    match /products/{productId} {
      allow read: if isUserActive() && isValidId(productId);
      allow create, update: if isUserActive() && isValidId(productId);
      allow delete: if isAdmin() && isValidId(productId);
    }

    // 3. Sales Records Collection
    match /sales/{saleId} {
      allow read, create, update: if isUserActive() && isValidId(saleId);
      allow delete: if isAdmin() && isValidId(saleId);
    }

    // 4. Customers Collection
    match /customers/{customerId} {
      allow read, create, update: if isUserActive() && isValidId(customerId);
      allow delete: if isAdmin() && isValidId(customerId);
    }

    // 5. Employees Collection
    match /employees/{employeeId} {
      allow read, create, update: if isUserActive() && isValidId(employeeId);
      allow delete: if isAdmin() && isValidId(employeeId);
    }

    // 6. Branch Configurations
    match /branches/{branchId} {
      allow read: if isUserActive() && isValidId(branchId);
      allow create, update, delete: if isAdmin() && isValidId(branchId);
    }

    // 7. Account Movements (Current Accounts)
    match /accountMovements/{movId} {
      allow read, create, update: if isUserActive() && isValidId(movId);
      allow delete: if isAdmin() && isValidId(movId);
    }

    // 8. Cash Movements
    match /cashMovements/{movId} {
      allow read, create, update: if isUserActive() && isValidId(movId);
      allow delete: if isAdmin() && isValidId(movId);
    }

    // 9. Cash Z Closures
    match /cashClosures/{closureId} {
      allow read, create, update: if isUserActive() && isValidId(closureId);
      allow delete: if isAdmin() && isValidId(closureId);
    }

    // 10. Electronic Invoices
    match /electronicInvoices/{invId} {
      allow read, create, update: if isUserActive() && isValidId(invId);
      allow delete: if isAdmin() && isValidId(invId);
    }

    // 11. ARCA Configuration (Metadata)
    match /arcaConfig/{cfgId} {
      allow read: if isUserActive() && isValidId(cfgId);
      allow create, update, delete: if isAdmin() && isValidId(cfgId);
    }

    // 12. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isUserActive() && isValidId(logId);
      allow create: if isUserActive() && isValidId(logId);
      allow update, delete: if isAdmin() && isValidId(logId);
    }

    // 13. Branch Stock
    match /branchStock/{stockId} {
      allow read, create, update: if isUserActive() && isValidId(stockId);
      allow delete: if isAdmin() && isValidId(stockId);
    }

    // 14. Stock Movements
    match /stockMovements/{movementId} {
      allow read, create, update: if isUserActive() && isValidId(movementId);
      allow delete: if isAdmin() && isValidId(movementId);
    }

    // 15. Stock Transfers (NECO 1 <-> NECO 2)
    match /stockTransfers/{transferId} {
      allow read, create, update: if isUserActive() && isValidId(transferId);
      allow delete: if isAdmin() && isValidId(transferId);
    }

    // 16. Physical Inventories
    match /physicalInventories/{invId} {
      allow read, create, update: if isUserActive() && isValidId(invId);
      allow delete: if isAdmin() && isValidId(invId);
    }

    // 17. Meat Debonings
    match /meatDebonings/{deboningId} {
      allow read, create, update: if isUserActive() && isValidId(deboningId);
      allow delete: if isAdmin() && isValidId(deboningId);
    }

    // 18. Meat Receptions
    match /meatReceptions/{receptionId} {
      allow read, create, update: if isUserActive() && isValidId(receptionId);
      allow delete: if isAdmin() && isValidId(receptionId);
    }

    // 19. Deboning Yield Templates
    match /deboningTemplates/{templateId} {
      allow read, create, update: if isUserActive() && isValidId(templateId);
      allow delete: if isAdmin() && isValidId(templateId);
    }

    // 20. Idempotency Keys (Protected against unauthorized user modification)
    match /idempotencyKeys/{keyId} {
      allow read, create, update: if isSignedIn() && isValidId(keyId);
      allow delete: if isAdmin() && isValidId(keyId);
    }
  }
}
