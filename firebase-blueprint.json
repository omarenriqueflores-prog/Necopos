{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Butcher shop product cut item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "pricePerKg": { "type": "number" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "code", "name", "pricePerKg", "category"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed POS sale transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNumber": { "type": "string" },
        "date": { "type": "string" },
        "branchId": { "type": "string" },
        "branchName": { "type": "string" },
        "operator": { "type": "string" },
        "subtotal": { "type": "number" },
        "vat": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "invoiceType": { "type": "string" }
      },
      "required": ["id", "ticketNumber", "date", "total", "paymentMethod"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Cuenta Corriente habitual customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cuit": { "type": "string" },
        "vatCondition": { "type": "string" },
        "phone": { "type": "string" },
        "currentBalance": { "type": "number" },
        "creditLimit": { "type": "number" }
      },
      "required": ["id", "name", "currentBalance"]
    },
    "ElectronicInvoice": {
      "title": "ElectronicInvoice",
      "description": "ARCA / AFIP Electronic invoice or credit note (WSFEv1)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "branchId": { "type": "string" },
        "pointOfSale": { "type": "string" },
        "cbteTipo": { "type": "number" },
        "cbteLetra": { "type": "string" },
        "cbteNumero": { "type": "number" },
        "formattedNumber": { "type": "string" },
        "date": { "type": "string" },
        "cae": { "type": "string" },
        "caeVto": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "branchId", "pointOfSale", "cbteTipo", "cbteNumero", "totalAmount", "status"]
    },
    "ArcaConfig": {
      "title": "ArcaConfig",
      "description": "ARCA global configuration and credentials state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cuit": { "type": "string" },
        "companyName": { "type": "string" },
        "environment": { "type": "string" },
        "alias": { "type": "string" },
        "hasCertificate": { "type": "boolean" },
        "hasPrivateKey": { "type": "boolean" },
        "certificateLinked": { "type": "boolean" },
        "certificateSubject": { "type": "string" },
        "certificateIssuer": { "type": "string" },
        "certificateValidTo": { "type": "string" },
        "vaultBundle": { "type": "string" }
      },
      "required": ["cuit", "companyName", "environment"]
    },
    "BranchStock": {
      "title": "BranchStock",
      "description": "Stock balance per product and branch chamber",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "branchId": { "type": "string" },
        "productId": { "type": "string" },
        "productCode": { "type": "string" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "branchId", "productId", "productCode", "currentStock"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Immutable ledger of stock movements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "branchId": { "type": "string" },
        "productCode": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "factor": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "unitPrice": { "type": "number" },
        "operator": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "branchId", "productCode", "type", "quantity", "newStock", "operator"]
    },
    "StockTransfer": {
      "title": "StockTransfer",
      "description": "Inter-branch meat stock transfers with traceability",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transferNumber": { "type": "string" },
        "originBranch": { "type": "string" },
        "destinationBranch": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdByUser": { "type": "string" },
        "totalKilos": { "type": "number" },
        "totalCommercialValue": { "type": "number" }
      },
      "required": ["id", "transferNumber", "originBranch", "destinationBranch", "status"]
    },
    "PhysicalInventory": {
      "title": "PhysicalInventory",
      "description": "Physical chamber count audits and reconcile adjustments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "inventoryNumber": { "type": "string" },
        "branchId": { "type": "string" },
        "chamber": { "type": "string" },
        "date": { "type": "string" },
        "operator": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "inventoryNumber", "branchId", "date", "status"]
    },
    "MeatDeboning": {
      "title": "MeatDeboning",
      "description": "Carcass deboning, meat yields, and cuts breakdown order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "branchId": { "type": "string" },
        "tropaNumber": { "type": "string" },
        "carcassType": { "type": "string" },
        "initialWeightKg": { "type": "number" },
        "totalInitialCost": { "type": "number" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "operator": { "type": "string" }
      },
      "required": ["id", "code", "branchId", "tropaNumber", "initialWeightKg", "status", "date"]
    },
    "MeatReception": {
      "title": "MeatReception",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "branchId": { "type": "string" },
        "chamber": { "type": "string" },
        "date": { "type": "string" },
        "supplier": { "type": "string" },
        "tropaNumber": { "type": "string" },
        "totalWeightKg": { "type": "number" },
        "totalCost": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "code", "branchId", "tropaNumber", "totalWeightKg", "status", "date"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of butcher shop products"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Completed sales transactions"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customers with credit accounts"
    },
    "/electronicInvoices/{invId}": {
      "schema": "ElectronicInvoice",
      "description": "ARCA electronic invoices and credit notes"
    },
    "/arcaConfig/{cfgId}": {
      "schema": "ArcaConfig",
      "description": "Global ARCA settings"
    },
    "/branchStock/{stockId}": {
      "schema": "BranchStock",
      "description": "Branch chamber stock balances"
    },
    "/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Stock movements ledger"
    },
    "/stockTransfers/{transferId}": {
      "schema": "StockTransfer",
      "description": "Inter-branch stock transfers"
    },
    "/physicalInventories/{invId}": {
      "schema": "PhysicalInventory",
      "description": "Physical counts and chamber audits"
    },
    "/meatDebonings/{deboningId}": {
      "schema": "MeatDeboning",
      "description": "Deboning operations and cuts traceability"
    },
    "/meatReceptions/{receptionId}": {
      "schema": "MeatReception",
      "description": "Incoming carcass reception and SENASA traceability"
    }
  }
}
